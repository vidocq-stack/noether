<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.noether</groupId>
        <artifactId>noether-root</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.vidocq.noether</groupId>
    <artifactId>noether-validation</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Noether :: Validation</name>
    <description>Jakarta Validation 3.1 (Bean Validation) implementation for the Vidocq ecosystem.</description>
    <url>https://codefloe.com/Vidocq/noether</url>

    <scm>
        <connection>scm:git:https://codefloe.com/Vidocq/noether.git</connection>
        <developerConnection>scm:git:ssh://git@codefloe.com/Vidocq/noether.git</developerConnection>
        <url>https://codefloe.com/Vidocq/noether</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot-Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    <!--
        Disjunctive triple license: a recipient may use this software under
        ANY ONE of the three licences below, at their option. EPL-2.0 is the
        anchor (see the LICENSE file); per EPL-2.0 section 1, GPL-2.0-or-later
        is offered as a Secondary License.
        SPDX-License-Identifier: EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later
    -->
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- Local test/TCK stopgap: never publish this aggregator or its children. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <jakarta.validation.version>3.1.1</jakarta.validation.version>
    </properties>

    <!--
        Further modules (noether-validation-processor, noether-validation-el, ...) are
        added milestone by milestone, each one with its first failing test — see
        ROADMAP.md. The TCK runner (noether-validation-tck) is never listed here: it is
        out of the reactor, like mansart-data-tck and mansart-transactions-tck.
    -->
    <modules>
        <module>noether-validation-core</module>
        <module>noether-validation-core-module-it</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.vidocq.noether</groupId>
                <artifactId>noether-validation-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta.validation.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
