            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
        <jakarta.validation.version>3.1.1</jakarta.validation.version>
    </properties>

    <!--
        Further modules (mansart-validation-processor, mansart-validation-el, ...) are
        added milestone by milestone, each one with its first failing test — see
        ROADMAP.md. The TCK runner (mansart-validation-tck) is never listed here: it is
        out of the reactor, like mansart-data-tck and mansart-transactions-tck.
    -->
    <modules>
        <module>mansart-validation-core</module>
        <module>mansart-validation-core-module-it</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.vidocq.mansart</groupId>
                <artifactId>mansart-validation-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta.validation.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
