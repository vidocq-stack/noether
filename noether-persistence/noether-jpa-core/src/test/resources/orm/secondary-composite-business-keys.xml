<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="3.2">
  <access>FIELD</access>
  <entity class="io.vidocq.noether.jpa.core.session.SecondaryBusinessKeyToOneTest$Part" name="SecondaryPart" metadata-complete="true">
    <table name="sb_part"/>
    <secondary-table name="xml_sb_part_details">
      <primary-key-join-column name="xml_part_pk" referenced-column-name="id"/>
      <unique-constraint><column-name>revision</column-name><column-name>part_code</column-name></unique-constraint>
    </secondary-table>
    <attributes>
      <id name="id"><generated-value strategy="IDENTITY"/></id>
      <basic name="code"><column name="part_code" table="xml_sb_part_details" nullable="false" updatable="false"/></basic>
      <basic name="revision"><column table="xml_sb_part_details" nullable="false" updatable="false"/></basic>
      <basic name="label"/>
    </attributes>
  </entity>
  <entity class="io.vidocq.noether.jpa.core.session.SecondaryBusinessKeyToOneTest$Item" name="SecondaryItem" metadata-complete="true">
    <table name="sb_item"/>
    <attributes>
      <id name="id"/>
      <many-to-one name="part" target-entity="io.vidocq.noether.jpa.core.session.SecondaryBusinessKeyToOneTest$Part" fetch="LAZY">
        <join-column name="part_code" referenced-column-name="part_code"/>
        <join-column name="part_revision" referenced-column-name="revision"/>
        <cascade><cascade-persist/></cascade>
      </many-to-one>
    </attributes>
  </entity>
  <entity class="io.vidocq.noether.jpa.core.session.SecondaryBusinessKeyToOneTest$PartBadge" name="SecondaryPartBadge" metadata-complete="true">
    <table name="sb_part_badge"/>
    <attributes>
      <id name="id"/>
      <one-to-one name="part" target-entity="io.vidocq.noether.jpa.core.session.SecondaryBusinessKeyToOneTest$Part">
        <join-column name="part_revision" referenced-column-name="revision"/>
        <join-column name="part_code" referenced-column-name="part_code"/>
        <cascade><cascade-persist/></cascade>
      </one-to-one>
    </attributes>
  </entity>
</entity-mappings>
