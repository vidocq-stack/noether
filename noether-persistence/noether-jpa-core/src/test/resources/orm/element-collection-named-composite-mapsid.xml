<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="3.2">
  <entity class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$CompositeTarget"
      access="FIELD" metadata-complete="true">
    <attributes><embedded-id name="id"/></attributes>
  </entity>
