        <join-column name="element_region" referenced-column-name="named_region_fk"/>
        <join-column name="element_serial" referenced-column-name="named_serial_fk"/>
        <join-column name="element_code" referenced-column-name="code"/>
      </many-to-one>
    </attributes>
  </embeddable>
  <embeddable class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$NamedCompositeKey"
      access="FIELD" metadata-complete="true">
