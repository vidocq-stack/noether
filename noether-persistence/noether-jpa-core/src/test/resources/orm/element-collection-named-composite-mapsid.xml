      name="NamedCompositeTarget" access="FIELD" metadata-complete="true">
    <attributes>
      <embedded-id name="id"/>
      <many-to-one name="parent" maps-id="parentKey">
        <join-column name="named_region_fk" referenced-column-name="region"/>
        <join-column name="named_serial_fk" referenced-column-name="serial"/>
        <cascade><cascade-persist/></cascade>
