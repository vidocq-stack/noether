<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="3.2">
  <entity class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$MapsIdElementParent"
      name="MapsIdElementParent" access="FIELD" metadata-complete="true">
    <attributes>
      <id name="id"><generated-value strategy="IDENTITY"/></id>
      <basic name="name"/>
    </attributes>
  </entity>
  <entity class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$MultiMapsOwner"
      name="MultiMapsOwner" access="FIELD" metadata-complete="true">
    <attributes>
      <id name="id"/>
      <element-collection name="values">
        <order-column name="value_position"/>
        <collection-table name="multi_maps_values">
          <join-column name="owner_id"/>
        </collection-table>
      </element-collection>
    </attributes>
  </entity>
  <entity class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$MultiMapsTarget"
      name="MultiMapsTarget" access="FIELD" metadata-complete="true">
    <attributes>
      <embedded-id name="id"/>
      <many-to-one name="source" maps-id="sourceId">
        <join-column name="source_fk"/>
        <cascade><cascade-persist/></cascade>
      </many-to-one>
      <many-to-one name="destination" maps-id="destinationId">
        <join-column name="destination_fk"/>
        <cascade><cascade-persist/></cascade>
      </many-to-one>
    </attributes>
  </entity>
  <embeddable class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$MultiMapsValue"
      access="FIELD" metadata-complete="true">
    <attributes>
      <basic name="label"/>
      <many-to-one name="target">
        <join-column name="element_source" referenced-column-name="source_fk"/>
        <join-column name="element_code" referenced-column-name="route_code"/>
        <join-column name="element_destination" referenced-column-name="destination_fk"/>
      </many-to-one>
    </attributes>
  </embeddable>
  <embeddable class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$MultiMapsKey"
      access="FIELD" metadata-complete="true">
    <attributes>
      <basic name="sourceId"/>
      <basic name="destinationId"/>
      <basic name="code"><column name="route_code"/></basic>
    </attributes>
  </embeddable>
</entity-mappings>
