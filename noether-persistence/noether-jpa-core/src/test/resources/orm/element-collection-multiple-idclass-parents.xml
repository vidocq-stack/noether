<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="3.2">
  <entity class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$MultiParentOwner"
      name="MultiParentOwner" access="FIELD" metadata-complete="true">
    <attributes>
      <id name="id"/>
      <element-collection name="values">
        <order-column name="value_position"/>
        <collection-table name="multi_parent_values">
          <join-column name="owner_id"/>
        </collection-table>
      </element-collection>
    </attributes>
  </entity>
  <embeddable class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$MultiParentValue"
      access="FIELD" metadata-complete="true">
    <attributes>
      <basic name="label"/>
      <many-to-one name="target">
        <join-column name="element_source" referenced-column-name="source_fk"/>
        <join-column name="element_code" referenced-column-name="route_code"/>
        <join-column name="element_destination" referenced-column-name="destination_fk"/>
      </many-to-one>
    </attributes>
  </embeddable>
</entity-mappings>
