      <id name="id"/>
      <element-collection name="values">
        <order-column name="value_position"/>
        <collection-table name="composite_link_values">
          <join-column name="owner_id"/>
        </collection-table>
      </element-collection>
    </attributes>
  </entity>
  <embeddable class="io.vidocq.noether.jpa.core.session.ElementCollectionRelationsTest$CompositeLinkValue"
      access="FIELD" metadata-complete="true">
    <attributes>
      <basic name="label"/>
      <many-to-one name="target">
        <join-column name="element_embedded_region" referenced-column-name="embedded_region_fk"/>
        <join-column name="element_idclass_region" referenced-column-name="idclass_region_fk"/>
        <join-column name="element_code" referenced-column-name="link_code"/>
        <join-column name="element_idclass_serial" referenced-column-name="idclass_serial_fk"/>
        <join-column name="element_embedded_serial" referenced-column-name="embedded_serial_fk"/>
      </many-to-one>
    </attributes>
  </embeddable>
</entity-mappings>
