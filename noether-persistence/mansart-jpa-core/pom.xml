<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-jpa</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-jpa-core</artifactId>
    <name>Mansart :: Jakarta Persistence 3.2 :: Core</name>
    <description>The Jakarta Persistence 3.2 provider: bootstrap, entity manager factory, entity manager, persistence context, JDBC execution.</description>

    <dependencies>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
            <optional>true</optional>
        </dependency>
        <!-- Decision D7: units configured by jakarta.persistence.jdbc.* get a mansart-pool pool (zero-dep, virtual-thread-native). -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-pool-core</artifactId>
        </dependency>
        <!-- Decision D4: the SQL AST and dialect SPI of Mansart JPA (JDK only). -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-jpa-dialect-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-jpa-dialect-h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-validation-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-opens io.vidocq.mansart.jpa.core/io.vidocq.mansart.jpa.core.session=io.vidocq.mansart.validation.core</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
