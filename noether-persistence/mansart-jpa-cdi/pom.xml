<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.vidocq.mansart</groupId><artifactId>mansart-jpa</artifactId><version>0.4.0-SNAPSHOT</version></parent>
    <artifactId>mansart-jpa-cdi</artifactId>
    <name>Mansart :: Persistence :: CDI and JTA integration</name>
    <dependencies>
        <dependency><groupId>io.vidocq.mansart</groupId><artifactId>mansart-jpa-core</artifactId></dependency>
        <!-- Existing JDBC XA adapter; production integration does not reimplement the transaction manager. -->
        <dependency><groupId>io.vidocq.mansart</groupId><artifactId>mansart-transactions-jdbc</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>jakarta.transaction</groupId><artifactId>jakarta.transaction-api</artifactId><version>2.0.1</version></dependency>
        <dependency><groupId>jakarta.enterprise</groupId><artifactId>jakarta.enterprise.cdi-api</artifactId><version>4.1.0</version></dependency>
        <dependency><groupId>jakarta.inject</groupId><artifactId>jakarta.inject-api</artifactId><version>2.0.1</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.vidocq.mansart</groupId><artifactId>mansart-jpa-dialect-h2</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
            <!-- Only nested test entities need the Class-File API bootstrap fallback, not production integration code. -->
            <configuration><argLine>--add-opens io.vidocq.mansart.jpa.cdi/io.vidocq.mansart.jpa.cdi=io.vidocq.mansart.jpa.core</argLine></configuration>
        </plugin>
    </plugins></build>
</project>
