<?xml version="1.0" encoding="UTF-8"?>
<!--
    OUT OF THE REACTOR — standalone modelVersion 4.0.0 POM (no <parent>), like mansart-data-tck,
    mansart-transactions-tck and mansart-validation-tck. Never listed in a <modules> section, never built through
    `mvn -pl`: run it through run-official-tck-persistence-3.2.sh.

    It holds NO Java. The tests come from jakarta.tck:persistence-tck-spec-tests (not on Maven Central:
    install-tck.sh installs it from the official bundle). In standalone mode the TCK builds its own deployment jar
    and persistence.xml (template from persistence-tck-common); the provider under test is only named, through
    the jakarta.persistence.provider system property.

    Two failsafe executions, as in the reference runner of the bundle (bin/pom.xml):
      1. the whole suite, minus Client2#createEntityManagerFactoryNoBeanValidatorTest;
      2. that test alone, with no Bean Validation on the class path.
    Execution 1 gets jakarta.validation-api and mansart-validation-core only with -Dtck.validation=on.

    Pitfalls (see ../ROADMAP.md, P0): never add a class named *Client* here (it would match the selection and pass
    for a TCK test); never put another persistence provider (Hibernate, EclipseLink) on the class path, which is
    why every transitive dependency of the TCK artifacts is excluded and listed explicitly below.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.vidocq.mansart</groupId>
    <artifactId>mansart-jpa-tck</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Mansart :: Jakarta Persistence 3.2 :: TCK runner</name>
    <description>
        Runs the official Jakarta Persistence 3.2 TCK against the Mansart provider, on PostgreSQL. Standalone: invoked
        through run-official-tck-persistence-3.2.sh, never via the parent reactor.
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <mansart.version>0.4.0-SNAPSHOT</mansart.version>
        <tck.version>3.2.1</tck.version>
        <!-- Versions used by the TCK itself (persistence-tck-3.2.1.pom). -->
        <junit.version>5.11.4</junit.version>
        <jakarta.tck.common.version>11.0.0-RC6</jakarta.tck.common.version>
        <jakarta.tck.sigtest.version>11.0.0-RC5</jakarta.tck.sigtest.version>
        <shrinkwrap.version>1.2.6</shrinkwrap.version>
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.ejb.version>4.0.1</jakarta.ejb.version>
        <jakarta.transaction.version>2.0.1</jakarta.transaction.version>
        <jakarta.validation.version>3.1.1</jakarta.validation.version>
        <postgresql.version>42.7.4</postgresql.version>

        <!-- The provider under test. Until milestone P1 delivers it, every test fails on "no provider". -->
        <tck.provider>io.vidocq.mansart.jpa.core.MansartPersistenceProvider</tck.provider>
        <!-- "key=value:key=value"; never empty, the TCK puts it in a java.util.Properties. -->
        <tck.provider.properties>io.vidocq.mansart.tck=true</tck.provider.properties>
        <tck.second.level.cache>false</tck.second.level.cache>

        <tck.jdbc.driver>org.postgresql.Driver</tck.jdbc.driver>
        <tck.jdbc.url>jdbc:postgresql://localhost:5432/jpatck</tck.jdbc.url>
        <tck.jdbc.user>cts1</tck.jdbc.user>
        <tck.jdbc.password>cts1</tck.jdbc.password>
        <tck.jdbc.db>postgresql</tck.jdbc.db>
        <tck.db.supports.sequence>true</tck.db.supports.sequence>

        <!-- Test selection of execution 1; the script narrows it with its area option. -->
        <tck.tests>**/*Client*,**/*JPASigTest*</tck.tests>
        <tck.no.validator.test>**/ee/jakarta/tck/persistence/se/entityManagerFactory/Client2#createEntityManagerFactoryNoBeanValidatorTest</tck.no.validator.test>
        <tck.skip.execution2>false</tck.skip.execution2>
        <!-- Filled by the tck-validation profile. -->
        <tck.validation.classpath></tck.validation.classpath>
        <tck.lib>${project.build.directory}/tck-lib</tck.lib>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The API. The provider will come next to it (milestone P1). -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta.persistence.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- The official tests. Every transitive dependency is cut: the spec-tests POM lists Hibernate ORM. -->
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>persistence-tck-spec-tests</artifactId>
            <version>${tck.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>persistence-tck-common</artifactId>
            <version>${tck.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>dbprocedures</artifactId>
            <version>${tck.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- What the TCK classes need at run time, listed explicitly. -->
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>common</artifactId>
            <version>${jakarta.tck.common.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>signaturetest</artifactId>
            <version>${jakarta.tck.sigtest.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>sigtest-maven-plugin</artifactId>
            <version>2.6</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-impl-base</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ejb</groupId>
            <artifactId>jakarta.ejb-api</artifactId>
            <version>${jakarta.ejb.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <version>${jakarta.transaction.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The API jar is needed as a file by the signature test. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-api-for-signature-test</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${tck.lib}</outputDirectory>
                            <stripVersion>true</stripVersion>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>jakarta.persistence</groupId>
                                    <artifactId>jakarta.persistence-api</artifactId>
                                    <version>${jakarta.persistence.version}</version>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <dependenciesToScan>
                        <dependency>jakarta.tck:persistence-tck-spec-tests</dependency>
                    </dependenciesToScan>
                    <!-- The TCK is the contract: report it, the script reads the reports. -->
                    <testFailureIgnore>true</testFailureIgnore>
                    <trimStackTrace>false</trimStackTrace>
                    <!-- Every property the TCK reads: a missing one is a NullPointerException in its setup. -->
                    <systemPropertyVariables>
                        <platform.mode>standalone</platform.mode>
                        <vehicle>standalone</vehicle>
                        <persistence.unit.name>JPATCK</persistence.unit.name>
                        <persistence.unit.name.2>JPATCK2</persistence.unit.name.2>
                        <jakarta.persistence.provider>${tck.provider}</jakarta.persistence.provider>
                        <jakarta.persistence.jdbc.driver>${tck.jdbc.driver}</jakarta.persistence.jdbc.driver>
                        <jakarta.persistence.jdbc.url>${tck.jdbc.url}</jakarta.persistence.jdbc.url>
                        <jakarta.persistence.jdbc.user>${tck.jdbc.user}</jakarta.persistence.jdbc.user>
                        <jakarta.persistence.jdbc.password>${tck.jdbc.password}</jakarta.persistence.jdbc.password>
                        <jpa.provider.implementation.specific.properties>${tck.provider.properties}</jpa.provider.implementation.specific.properties>
                        <persistence.second.level.caching.supported>${tck.second.level.cache}</persistence.second.level.caching.supported>
                        <db.supports.sequence>${tck.db.supports.sequence}</db.supports.sequence>
                        <jdbc.db>${tck.jdbc.db}</jdbc.db>
                        <Insert_Jpa_Purchase_Order>INSERT INTO PURCHASE_ORDER(ID, TOTAL, DESCRIPTION) VALUES(?, ?, null)</Insert_Jpa_Purchase_Order>
                        <Select_Jpa_Purchase_Order>SELECT ID, TOTAL FROM PURCHASE_ORDER WHERE ID=?</Select_Jpa_Purchase_Order>
                        <log.file.location>${project.build.directory}</log.file.location>
                        <sigTestClasspath>${tck.lib}/jakarta.persistence-api.jar${path.separator}${project.build.directory}/jdk-bundle/java.base${path.separator}${project.build.directory}/jdk-bundle/java.rmi${path.separator}${project.build.directory}/jdk-bundle/java.sql${path.separator}${project.build.directory}/jdk-bundle/java.naming</sigTestClasspath>
                        <jimage.dir>${project.build.directory}/jdk-bundle</jimage.dir>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>persistence-tests-1</id>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <test>${tck.tests},!${tck.no.validator.test}</test>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${tck.validation.classpath}</additionalClasspathElement>
                            </additionalClasspathElements>
                            <!-- One directory per execution: Client2 runs in both and its report would be overwritten. -->
                            <reportsDirectory>${project.build.directory}/failsafe-reports/execution-1</reportsDirectory>
                            <summaryFile>${project.build.directory}/failsafe-reports/execution-1/failsafe-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>persistence-tests-2</id>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <skip>${tck.skip.execution2}</skip>
                            <test>${tck.no.validator.test}</test>
                            <reportsDirectory>${project.build.directory}/failsafe-reports/execution-2</reportsDirectory>
                            <summaryFile>${project.build.directory}/failsafe-reports/execution-2/failsafe-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Bean Validation on the class path of execution 1 only: jakarta.validation-api and mansart-validation-core. -->
        <profile>
            <id>tck-validation</id>
            <activation>
                <property>
                    <name>tck.validation</name>
                    <value>on</value>
                </property>
            </activation>
            <properties>
                <tck.validation.classpath>${tck.lib}/validation/jakarta.validation-api.jar,${tck.lib}/validation/mansart-validation-core.jar</tck.validation.classpath>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-validation</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${tck.lib}/validation</outputDirectory>
                                    <stripVersion>true</stripVersion>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>jakarta.validation</groupId>
                                            <artifactId>jakarta.validation-api</artifactId>
                                            <version>${jakarta.validation.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>io.vidocq.mansart</groupId>
                                            <artifactId>mansart-validation-core</artifactId>
                                            <version>${mansart.version}</version>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
