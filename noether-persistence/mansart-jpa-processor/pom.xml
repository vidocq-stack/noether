<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.mansart</groupId>
        <artifactId>mansart-jpa</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>mansart-jpa-processor</artifactId>
    <name>Mansart :: Jakarta Persistence 3.2 :: Annotation processor</name>
    <description>APT generating, for the entities of an application, the accesses Mansart JPA uses instead of hidden classes defined at bootstrap: no opened package, nothing defined at run time.</description>

    <dependencies>
        <!-- The processor plans the accesses with the provider's own AccessPlanner (exported to this module only). -->
        <dependency>
            <groupId>io.vidocq.mansart</groupId>
            <artifactId>mansart-jpa-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- This module IS a processor, so disable processing on itself. -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
