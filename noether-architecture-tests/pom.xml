<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.noether</groupId>
        <artifactId>noether-root</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>noether-architecture-tests</artifactId>
    <name>Noether :: Architecture tests</name>
    <description>The architecture rules of Noether as tests, applied to the classes of every shipped module
        (Vidocq/vidocq#289)</description>

    <properties>
        <!-- Test-only module: never released, installed or deployed. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <!--
        Every dependency is test-scoped: the module ships nothing. The eight shipped modules are listed so that
        ArchUnit imports their classes. The test, bench, TCK, integration-test and validation modules ship nothing.
    -->
    <dependencies>
        <dependency>
            <groupId>io.vidocq.noether</groupId>
            <artifactId>noether-jpa-dialect-spi</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.noether</groupId>
            <artifactId>noether-jpa-dialect-h2</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.noether</groupId>
            <artifactId>noether-jpa-dialect-postgresql</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.noether</groupId>
            <artifactId>noether-jpa-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.noether</groupId>
            <artifactId>noether-jpa-pool-mansart</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.noether</groupId>
            <artifactId>noether-jpa-processor</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.noether</groupId>
            <artifactId>noether-jpa-jta</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.noether</groupId>
            <artifactId>noether-jpa-cdi</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The architecture rules (Vidocq/vidocq#289): the shared vidocq-archrules library of
             vidocq-parent, test scope only, never shipped, next to JUnit (CLAUDE.md). It brings ArchUnit's
             core (Apache-2.0, slf4j-api). -->
        <dependency>
            <groupId>io.vidocq</groupId>
            <artifactId>vidocq-archrules</artifactId>
            <version>0.4.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- maven.deploy.skip is not enough: central-publishing replaces maven-deploy-plugin. -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
