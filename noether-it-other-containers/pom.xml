<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.vidocq.noether</groupId>
        <artifactId>noether-root</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>
    <artifactId>noether-it-other-containers</artifactId>
    <packaging>pom</packaging>
    <name>Noether :: Integration tests on other containers</name>
    <description>Noether, unchanged, inside containers other than Vidocq. Test vehicles, never released.</description>

    <properties>
        <!-- Test vehicles: never released. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <jakarta.transaction.version>2.0.1</jakarta.transaction.version>
        <h2.version>2.3.232</h2.version>
    </properties>

    <modules>
        <module>noether-it-openliberty</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
