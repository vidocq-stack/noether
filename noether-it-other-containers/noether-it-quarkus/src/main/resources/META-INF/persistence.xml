<?xml version="1.0" encoding="UTF-8"?>
<!--
    A JTA unit on Quarkus: Noether as the provider, on Quarkus' default data source (Agroal, configured in
    application.properties), which enlists its connections in Narayana's transactions. It names no jta-data-source,
    so noether-jpa-cdi takes the @Default javax.sql.DataSource bean.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="library" transaction-type="JTA">
        <provider>io.vidocq.noether.jpa.core.NoetherPersistenceProvider</provider>
        <class>io.vidocq.noether.it.quarkus.Book</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>
