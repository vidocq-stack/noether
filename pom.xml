<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.noether</groupId>
    <artifactId>noether-root</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Noether Root</name>
    <description>Jakarta Persistence 3.2 and a provisional Jakarta Validation 3.1 provider for the Vidocq ecosystem.</description>
    <url>https://codefloe.com/Vidocq/noether</url>

    <scm>
        <connection>scm:git:https://codefloe.com/Vidocq/noether.git</connection>
        <developerConnection>scm:git:ssh://git@codefloe.com/Vidocq/noether.git</developerConnection>
        <url>https://codefloe.com/Vidocq/noether</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot-Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    <!--
        Disjunctive triple license: a recipient may use this software under
        ANY ONE of the three licences below, at their option. EPL-2.0 is the
        anchor (see the LICENSE file); per EPL-2.0 section 1, GPL-2.0-or-later
        is offered as a Secondary License.
        SPDX-License-Identifier: EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later
    -->
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>noether-persistence</module>
        <module>noether-validation</module>
    </modules>

    <properties>
        <mansart.version>0.4.0-SNAPSHOT</mansart.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>

        <!--
            SonarQube (Vidocq/vidocq#284): every module reads the aggregated JaCoCo report of
            noether-coverage (quality profile), so the tests of the *-module-it modules count for
            the code they exercise in the other modules.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/noether-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>3.27.0</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!--
            Quality profile (with the one of vidocq-parent, which runs the JaCoCo agent): adds
            the aggregated coverage report that SonarQube reads (Vidocq/vidocq#284).
        -->
        <profile>
            <id>quality</id>
            <modules>
                <module>noether-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>
